# EditorConfig — reglas de formato unificadas para todo el equipo
# https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# En Markdown los espacios al final a veces tienen significado (saltos de línea)
[*.md]
trim_trailing_whitespace = false

# 2 espacios para los lenguajes que usan esa convención
[*.{dart,ts,tsx}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2
